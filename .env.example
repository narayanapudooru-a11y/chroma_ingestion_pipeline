# Windows example:
INGEST_SOURCE_DIR=D:\knowledge_documents
CHROMA_PERSIST_DIR=D:\chroma_data
CHROMA_COLLECTION=local_documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=250
EMBED_BATCH_SIZE=64
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
INGEST_LOG_DIR=D:\chroma_ingestion_logs
LOG_LEVEL=INFO
